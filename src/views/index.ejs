<%- include('layout', { section: 'head', title: 'Home', currentNav: 'home', session: session }) %>

<section class="hero">
  <h1>Twin Cities Flex Ladder</h1>
  <p>Singles tennis. Challenge anyone within 3 ranks above you. Public courts. No drama.</p>
  <% if (!session.userId) { %>
    <p><a href="/register" class="cta">Register · $30</a></p>
  <% } %>
</section>

<% if (season) { %>
  <section class="season-info">
    <h2><%= season.name %></h2>
    <p><%= totalPlayers %> registered player<%= totalPlayers === 1 ? '' : 's' %></p>
  </section>

  <section class="preview">
    <h2>Top 5 — <%= previewDivision %></h2>
    <% if (topPlayers.length === 0) { %>
      <p>No players in <%= previewDivision %> yet.</p>
    <% } else { %>
      <ol class="ladder-preview">
        <% topPlayers.forEach(p => { %>
          <li>
            <span class="rank">#<%= p.rank %></span>
            <a href="/profile/<%= p.id %>" class="player-name"><%= p.name %></a>
            <% if (p.location) { %><span class="location"><%= p.location %></span><% } %>
            <span class="record"><%= p.wins %>W <%= p.losses %>L</span>
          </li>
        <% }) %>
      </ol>
    <% } %>
    <p><a href="/ladder/<%= previewDivision %>">See full ladder &rarr;</a></p>
  </section>
<% } else { %>
  <section class="season-info">
    <p>No active season — please contact the administrator.</p>
  </section>
<% } %>

<%- include('layout', { section: 'foot' }) %>
