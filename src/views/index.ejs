<%- include('layout', { section: 'head', title: 'Home', currentNav: 'home', session: session }) %>

<section class="hero">
  <h1>Tournament Court Ladder</h1>
  <p>Tennis. Padel. Pickleball. Your court, your schedule.</p>
  <% if (!session.userId) { %>
    <p><a href="/register" class="cta">Register · $30 / year</a></p>
  <% } %>
</section>

<% if (season) { %>
  <section class="season-info">
    <h2><%= season.name %></h2>
    <p>
      Tennis: <strong><%= counts.tennis %></strong> &middot;
      Padel: <strong><%= counts.padel %></strong> &middot;
      Pickleball: <strong><%= counts.pickleball %></strong>
    </p>
  </section>

  <section class="preview">
    <h2>Top 5 — <%= previewSport %> <%= previewLevel %></h2>
    <% if (topPlayers.length === 0) { %>
      <p>No players in <%= previewSport %> <%= previewLevel %> yet.</p>
    <% } else { %>
      <ol class="ladder-preview">
        <% topPlayers.forEach(p => { %>
          <li>
            <span class="rank">#<%= p.rank %></span>
            <a href="/profile/<%= p.id %>" class="player-name"><%= p.name %></a>
            <% if (p.location) { %><span class="location"><%= p.location %></span><% } %>
            <span class="record"><%= p.wins %>W <%= p.losses %>L</span>
          </li>
        <% }) %>
      </ol>
    <% } %>
    <p><a href="/ladder/<%= previewSport %>/<%= previewLevel %>">See full ladder &rarr;</a></p>
  </section>
<% } else { %>
  <section class="season-info">
    <p>No active season — please contact the administrator.</p>
  </section>
<% } %>

<%- include('layout', { section: 'foot' }) %>
