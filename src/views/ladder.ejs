<%- include('layout', { section: 'head', title: 'Ladder · ' + sport + ' ' + level, currentNav: 'ladder', session: session }) %>

<h1>Ladder &middot; <%= sport %> <%= level %></h1>

<nav class="sport-tabs">
  <% sports.forEach(s => { %>
    <a href="/ladder/<%= s %>/<%= s === 'tennis' ? '3.5' : 'intermediate' %>"
       class="sport-tab<%- s === sport ? ' active' : '' %>"><%= s %></a>
  <% }) %>
</nav>

<nav class="division-tabs">
  <% validLevels.forEach(l => { %>
    <a href="/ladder/<%= sport %>/<%= l %>"<%- l === level ? ' class="active"' : '' %>><%= l %></a>
  <% }) %>
</nav>

<% if (!season) { %>
  <p>No active season.</p>
<% } else if (players.length === 0) { %>
  <p>No players in <%= sport %> <%= level %> yet.</p>
<% } else { %>
  <table class="ladder-table">
    <thead>
      <tr>
        <th>Rank</th>
        <th>Name</th>
        <th>Location</th>
        <th>W</th>
        <th>L</th>
      </tr>
    </thead>
    <tbody>
      <% players.forEach(p => { %>
        <tr>
          <td>#<%= p.rank %></td>
          <td><a href="/profile/<%= p.id %>"><%= p.name %></a></td>
          <td><%= p.location || '' %></td>
          <td><%= p.wins %></td>
          <td><%= p.losses %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('layout', { section: 'foot' }) %>
